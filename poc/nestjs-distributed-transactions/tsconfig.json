{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "sourceMap": true,
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@cmd/*": [
        "./src/cmd/*"
      ],
      "@domain/*": [
        "./src/internal/domain/*"
      ],
      "@application/*": [
        "./src/internal/application/*"
      ],
      "@infrastructure/*": [
        "./src/internal/infrastructure/*"
      ],
      "@internal/*": [
        "./src/internal/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
