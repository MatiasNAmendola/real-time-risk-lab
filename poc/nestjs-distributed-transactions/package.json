{
  "name": "nestjs-distributed-transactions",
  "version": "0.1.0",
  "description": "PoC NestJS para sagas, CQRS, Event Sourcing y ledger TigerBeetle en el laboratorio de riesgo transaccional.",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "bun run test:unit && bun run test:integration",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:unit": "bun test src",
    "test:integration": "bun test tests/integration/*.ts",
    "test:e2e": "bun test tests/e2e/*.ts",
    "test:smoke": "bun run tests/smoke/http.smoke.ts",
    "test:atdd": "bun run test:atdd:feature",
    "test:k6": "K6_REQUIRED=true ./scripts/k6-smoke.sh",
    "test:k6:optional": "./scripts/k6-smoke.sh",
    "test:atdd:e2e": "bun test tests/e2e/atdd-http.e2e.test.ts",
    "test:atdd:feature": "cucumber-js \"tests/atdd/**/*.feature\" --require \"tests/atdd/steps/**/*.js\" --format progress"
  },
  "dependencies": {
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/swagger": "11.4.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/instrumentation-http": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "bullmq": "5.77.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tigerbeetle-node": "0.17.4",
    "uuid": "14.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "eslint": "10.4.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  }
}
