{
  "name": "hono-distributed-transactions",
  "version": "0.1.0",
  "description": "PoC Hono para contrastar Saga, CQRS, Event Sourcing y EDA contra NestJS.",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun run test:unit && bun run test:integration",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:unit": "bun test src",
    "test:integration": "bun test tests/integration/*.ts",
    "test:e2e": "bun test tests/e2e/*.ts",
    "test:smoke": "bun run tests/smoke/http.smoke.ts",
    "test:atdd": "bun run test:atdd:feature",
    "test:k6": "K6_REQUIRED=true ./scripts/k6-smoke.sh",
    "test:k6:optional": "./scripts/k6-smoke.sh",
    "test:atdd:e2e": "bun test tests/e2e/atdd-http.e2e.test.ts",
    "test:atdd:feature": "cucumber-js \"tests/atdd/**/*.feature\" --require \"tests/atdd/steps/**/*.js\" --format progress"
  },
  "dependencies": {
    "@hono/node-server": "2.0.4",
    "bullmq": "5.77.7",
    "hono": "4.12.23",
    "ioredis": "5.11.0",
    "zod": "4.4.3",
    "tigerbeetle-node": "0.17.4"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "eslint": "10.4.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  }
}
